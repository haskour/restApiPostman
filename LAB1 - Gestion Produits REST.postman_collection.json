  "item": [
    {
      "name": "Création",
      "item": [
        {
          "name": "AddProduct",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Vérifier que le statut est 200 ou 201\npm.test(\"Statut de création valide\", function () {\n    pm.response.to.have.status(201);\n});\n\n// Extraire l'ID du produit créé et le stocker dans une variable globale/environnement\nvar jsonData = pm.response.json();\npm.environment.set(\"createdProductId\", jsonData.id);\nconsole.log(\"ID du produit créé : \" + jsonData.id);\n\n\npm.test(\"Le code de statut est 400 Bad Request\", function () {\n    pm.response.to.have.status(400);\n});\n\npm.test(\"La réponse indique une erreur de validation ou de format\", function () {\n    var jsonData = pm.response.json();\n    // Selon l'API, la structure peut varier (message, error, details...)\n    pm.expect(jsonData).to.satisfy(function(body) {\n        return body.message !== undefined || body.error !== undefined;\n    });\n});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Casque Audio Sans Fil\",\n  \"price\": 129.99,\n  \"category\": \"audio\",\n  \"stock\": 25\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/products/add",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products",
                "add"
              ]
            }
          },
          "response": []
        },
        {
